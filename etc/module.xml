<?xml version="1.0"?>
<!--
  Magenx_Blog: a self-contained headless blog content module.

  There is no stock Magento "Blog" module to wrap — this module owns its own
  entities (post, category, tag) end to end, together with the admin CRUD that
  authors them. No view/frontend: the storefront is Next.js, and content is
  authored exclusively through the Magento admin.

  The storefront-facing GraphQL surface is a separate module,
  Magenx_BlogGraphQl (magenxcommerce/module-blog-graph-ql), so a backend-only
  install carries no Magento_GraphQl dependency.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Magenx_Blog">
        <sequence>
            <module name="Magento_Backend"/>
            <module name="Magento_Config"/>
            <module name="Magento_Catalog"/>
            <module name="Magento_Cms"/>
            <module name="Magento_Store"/>
        </sequence>
    </module>
</config>
