<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::content">
                    <resource id="Magenx_Blog::blog" title="Blog" sortOrder="50">
                        <resource id="Magenx_Blog::post" title="Posts" sortOrder="10"/>
                        <resource id="Magenx_Blog::category" title="Categories" sortOrder="20"/>
                        <resource id="Magenx_Blog::tag" title="Tags" sortOrder="30"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
