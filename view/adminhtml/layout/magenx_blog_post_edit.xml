<?xml version="1.0"?>
<!--
  Tabbed post form. The tabs block lives in the left column and moves each
  tab's content into the single <form id="edit_form"> rendered in the content
  column (Tabs::setDestElementId). Rendering the tabs *as* the container's
  form child instead put the form inside the tab markup, so the widget tried
  to append an element to its own descendant — "HierarchyRequestError: The
  new child element contains the parent" — and the page stayed collapsed.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd" layout="admin-2columns-left">
    <body>
        <referenceContainer name="left">
            <block class="Magenx\Blog\Block\Adminhtml\Post\Edit\Tabs" name="post_edit_tabs"/>
        </referenceContainer>
        <referenceContainer name="content">
            <block class="Magenx\Blog\Block\Adminhtml\Post\Edit" name="post_edit">
                <block class="Magenx\Blog\Block\Adminhtml\Post\Edit\Form" name="post_edit_form" as="form"/>
            </block>
        </referenceContainer>
    </body>
</page>
